rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    // Public landing content can be read by everyone, but only admin allowlist can modify it.
    match /landing/main {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin allowlist documents are managed only by existing admin users.
    match /admin_users/{uid} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Audit logs are write-once from admin clients and visible only to admins.
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail is string
        && request.resource.data.action == "save_landing_content"
        && request.resource.data.targetPath == "landing/main";
      allow update, delete: if false;
    }

    // Deny access to any other documents by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
